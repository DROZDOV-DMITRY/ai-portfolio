---
import { visibleRecords, isEditorialPreview } from "../lib/catalog.js";
const records = visibleRecords();
---
<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><meta name="robots" content={isEditorialPreview ? "noindex,nofollow" : "index,follow"}><title>AI / Портфолио — каталог разработок V0.4</title><meta name="description" content="Макет авторского каталога AI-систем и агентов. Не является опубликованной продукцией."><link rel="stylesheet" href="/ai-portfolio/assets/styles.css"><link rel="icon" type="image/svg+xml" href="/ai-portfolio/brand/mark.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/ai-portfolio/brand/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/ai-portfolio/brand/favicon-16.png" />
<link rel="shortcut icon" href="/ai-portfolio/brand/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/ai-portfolio/brand/apple-touch-icon.png" />
<meta name="theme-color" content="#101212" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI / Портфолио" />
<meta property="og:image" content="https://drozdov-dmitry.github.io/ai-portfolio/brand/og-cover.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" /></head><body>
<div class="topline">{isEditorialPreview ? "РЕДАКЦИОННЫЙ ПРЕДПРОСМОТР · НЕ ПУБЛИКОВАТЬ" : "AI / ПОРТФОЛИО · ГОТОВИТСЯ К ОТКРЫТИЮ"}</div>
<header class="header shell"><a class="brand" href="/ai-portfolio/" aria-label="На главную каталога"><img class="brand-emblem" src="/ai-portfolio/brand/mark.svg" alt="" width="39" height="39" aria-hidden="true" /><span class="brand-copy"><span class="brand-name">AI / ПОРТФОЛИО</span><span class="brand-sub">Авторские интеллектуальные системы</span></span></a><nav class="navigation" aria-label="Основная навигация"><a class="nav-current" href="#catalog">Все решения</a><a href="#categories">Категории</a><a href="#catalog">Проекты</a><a href="#about">Об авторе</a></nav><div class="nav-actions"><button class="nav-icon" aria-label="Перейти к поиску" onclick="document.getElementById('search').focus()">⌕</button><a href="#about" class="small-outline">О проекте ↗</a></div></header>
<main><section class="hero shell"><div class="hero-top"><span class="eyebrow">AI / SYSTEMS / DEVELOPMENT</span><span class="hero-index">001 — {String(records.length).padStart(3,"0")}</span></div><h1>Интеллектуальные<br><em>системы.</em> Реальные задачи.</h1><p class="hero-summary">Авторские AI-агенты, цифровые инструменты и исследовательские проекты. Найдите решение по задаче, познакомьтесь с его возможностями и уровнем готовности.</p><form class="searchbar" id="hero-search-form"><span class="searchbar-icon" aria-hidden="true">⌕</span><input type="search" id="search" placeholder="Какую задачу нужно решить?" aria-label="Поиск по каталогу"><button type="submit">Найти ↗</button></form><div class="hero-note"><span>●</span> Поиск по названию, назначению и ключевым словам · <strong>{isEditorialPreview ? String(records.length) + " редакционных карточек" : String(records.length) + " проверенных и разрешённых описаний"}</strong></div></section>
<section class="shell" id="categories"><div class="section-row"><div><span class="eyebrow">01 / ОРИЕНТИРЫ</span><h2 class="section-heading">Направления работы</h2></div><div class="section-meta">Категории задач, а не названия технологий</div></div><div class="cats" role="group" aria-label="Категории каталога"><button type="button" class="cat-pill active" data-cat="all"><span class="cat-icon">◎</span><span class="cat-text">Все решения</span></button><button type="button" class="cat-pill" data-cat="education"><span class="cat-icon">⌁</span><span class="cat-text">Образование</span></button><button type="button" class="cat-pill" data-cat="business"><span class="cat-icon">▦</span><span class="cat-text">Бизнес и управление</span></button><button type="button" class="cat-pill" data-cat="marketing"><span class="cat-icon">↗</span><span class="cat-text">Маркетинг</span></button><button type="button" class="cat-pill" data-cat="media"><span class="cat-icon">◈</span><span class="cat-text">Креатив и медиа</span></button><button type="button" class="cat-pill" data-cat="docs"><span class="cat-icon">§</span><span class="cat-text">Право и документы</span></button><button type="button" class="cat-pill" data-cat="research"><span class="cat-icon">∴</span><span class="cat-text">Исследования</span></button><button type="button" class="cat-pill" data-cat="it"><span class="cat-icon">⌘</span><span class="cat-text">IT и автоматизация</span></button><button type="button" class="cat-pill" data-cat="personal"><span class="cat-icon">⌂</span><span class="cat-text">Повседневные задачи</span></button></div></section>
<section class="shell" id="catalog"><div class="section-row" style="padding-top:12px"><div><span class="eyebrow">02 / КАТАЛОГ</span><h2 class="section-heading">Решения и проекты</h2></div><span class="section-meta">От идеи до работающих систем</span></div><div class="catalog-layout"><aside class="sidebar" id="sidebar" aria-label="Фильтры"><div class="side-group"><div class="side-heading">Авторство <span>01</span></div><label class="check-row"><input type="radio" name="author" value="all" checked> Все записи</label><label class="check-row"><input type="radio" name="author" value="author"> Авторские разработки</label><label class="check-row"><input type="radio" name="author" value="student"> Ученические работы</label></div><div class="side-group"><div class="side-heading">Применимость к школе <span>02</span></div><label class="check-row"><input type="radio" name="school" value="all" checked> Все направления</label><label class="check-row"><input type="radio" name="school" value="direct"> Прямое школьное назначение</label><label class="check-row"><input type="radio" name="school" value="support"> Поддержка школьной работы</label></div><div class="side-note">Каталог находится на этапе наполнения: статусы основаны на сведениях автора, а содержимое ожидает редакционной и приватностной проверки.</div></aside><div class="catalog-main"><div class="controls"><span class="result-count" id="count" aria-live="polite"></span><div class="control-right"><button class="filter-toggle" id="filter-toggle" type="button" aria-expanded="false" aria-controls="sidebar">☷ Фильтры</button><span class="sort-label">Сортировка:</span><select class="sort-select" id="sort" aria-label="Сортировать"><option value="editorial">По подборке</option><option value="name">По названию</option><option value="status">По стадии</option></select><button class="clear-btn" id="clear-filters" type="button">Сброс</button></div></div><div class="cards" id="cards" aria-live="polite"></div></div></div></section></main>
<footer class="footer shell" id="about"><span>AI / ПОРТФОЛИО · Контентная сборка · V0.4</span><span>{isEditorialPreview ? "Редакционная сборка — без допуска к публикации" : "Только проверенные материалы"}</span></footer>
<script is:inline define:vars={{records}}>window.PORTFOLIO_RECORDS = records;</script><script is:inline src="/ai-portfolio/assets/catalog.js"></script></body></html>

