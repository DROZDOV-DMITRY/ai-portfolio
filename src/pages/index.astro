---
import { visibleRecords, isEditorialPreview } from "../lib/catalog.js";
import categories from "../data/categories.json";
const aiEndpoint=import.meta.env.PUBLIC_AI_SEARCH_ENDPOINT||"";
const turnstileKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY||"";
const categoryDescriptions={
 education:"Обучение, методики, творческие задания и поддержка преподавателей",
 business:"Управление, документы, переговоры и карьерные решения",
 marketing:"Продвижение, продажи, контент и работа с аудиторией",
 media:"Видео, тексты, дизайн, истории и AI-продакшн",
 docs:"Правовые вопросы, кадровая работа и документооборот",
 research:"Научные вопросы, анализ источников и исследовательские программы",
 it:"Инфраструктура, Windows, интеграции и инструменты разработчика",
 personal:"Практические помощники для повседневной жизни"
};
const categoryColors={education:"#70E7B0",business:"#8AC7FF",marketing:"#FEB487",media:"#F5A0CC",docs:"#B1ABFF",research:"#C8A7FF",it:"#7AE7F0",personal:"#9DE6C6"};

const records = visibleRecords();
const directions=categories.map(c=>({...c,short:categoryDescriptions[c.slug],color:categoryColors[c.slug],count:records.filter(r=>r.cat===c.slug).length}));
const cardsForClient = records.map(r=>({
 id:r.id,title:r.title,subtitle:r.public_pitch,public_pitch:r.public_pitch,public_label:r.public_label,
 cat:r.cat,category:r.category,kind:r.kind,audience:r.audience,school:r.school,
 status:"all",version:r.version,cover:r.cover,num:r.num,tags:r.tags,problem:r.problem,
 capabilities:r.capabilities,detail:r.detail,logo_path:r.logo_path
}));
---
<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><meta name="robots" content={isEditorialPreview ? "noindex,nofollow" : "index,follow"}><title>AI LAB — 68 ИИ-агентов и систем</title><meta name="description" content="Авторская экосистема из 68 ИИ-продуктов: агенты, системы, инструменты и интеллектуальные сервисы."><link rel="stylesheet" href="/ai-portfolio/assets/styles.css"><link rel="icon" type="image/svg+xml" href="/ai-portfolio/brand/mark.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/ai-portfolio/brand/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/ai-portfolio/brand/favicon-16.png" />
<link rel="shortcut icon" href="/ai-portfolio/brand/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/ai-portfolio/brand/apple-touch-icon.png" />
<meta name="theme-color" content="#101212" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI / Портфолио" />
<meta property="og:image" content="https://drozdov-dmitry.github.io/ai-portfolio/brand/og-cover.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" /></head><body>
<div class="topline">{isEditorialPreview ? "РЕДАКЦИОННЫЙ ПРЕДПРОСМОТР · НЕ ПУБЛИКОВАТЬ" : "AI / ПОРТФОЛИО · ГОТОВИТСЯ К ОТКРЫТИЮ"}</div>
<header class="header shell"><a class="brand" href="/ai-portfolio/" aria-label="На главную каталога"><img class="brand-emblem" src="/ai-portfolio/brand/mark.svg" alt="" width="39" height="39" aria-hidden="true" /><span class="brand-copy"><span class="brand-name">AI LAB / ПОРТФОЛИО</span><span class="brand-sub">ИИ-агенты и системы</span></span></a><nav class="navigation" aria-label="Основная навигация"><a class="nav-current" href="#catalog">Все решения</a><a href="#categories">Категории</a><a href="#catalog">Продукты</a><a href="/ai-portfolio/about/">Об авторе</a></nav><div class="nav-actions"><button class="nav-icon" aria-label="Перейти к поиску" onclick="document.getElementById('search').focus()">⌕</button><a href="/ai-portfolio/about/" class="small-outline">О проекте ↗</a></div></header>
<main><section class="hero shell"><div class="hero-top"><span class="eyebrow">AI LAB / ЭКОСИСТЕМА ИИ-ПРОДУКТОВ</span><span class="hero-index">001 — {String(records.length).padStart(3,"0")}</span></div><h1>ИИ-агенты<br><em>Интеллектуальные системы</em></h1><p class="hero-summary">68 авторских ИИ-продуктов в восьми направлениях. Каждый создан вокруг конкретной задачи — от образования и бизнеса до инфраструктуры и творчества.</p><form class="searchbar" id="hero-search-form"><span class="searchbar-icon" aria-hidden="true">⌕</span><input type="search" id="search" placeholder="Какую задачу нужно решить?" aria-label="Поиск по каталогу"><button type="submit">Найти ↗</button></form><div class="search-examples" aria-label="Примеры поисковых запросов">
<span class="search-examples-label">Попробуйте спросить</span>
<button type="button" data-search-example="Составить приказ об отпуске">Оформить отпуск <span>↗</span></button>
<button type="button" data-search-example="Превратить аудио в текст">Аудио в текст <span>↗</span></button>
<button type="button" data-search-example="Подобрать профессию школьнику">Выбрать профессию <span>↗</span></button>
<button type="button" data-search-example="Придумать короткое видео">Идея для ролика <span>↗</span></button>
</div><div class="hero-note"><span>●</span> Поиск по названию, назначению и ключевым словам · <strong>{isEditorialPreview ? String(records.length) + " ИИ-продуктов" : String(records.length) + " ИИ-продуктов"}</strong></div></section>
<section class="shell" id="categories"><div class="section-row"><div><span class="eyebrow">01 / ОРИЕНТИРЫ</span><h2 class="section-heading">Направления экосистемы</h2></div><div class="section-meta">Восемь миров решений — выбирайте свой</div></div><div class="category-headline"><p>Образование, наука, бизнес, медиа, технологии и повседневные решения — восемь направлений одной AI-экосистемы.</p><button type="button" class="category-reset active" data-cat="all" aria-pressed="true">Все {records.length} ИИ-продуктов <span aria-hidden="true">↗</span></button></div>
<div class="direction-grid" role="group" aria-label="Направления AI LAB">
{directions.map((c,i)=><button type="button" class={`direction-tile mood-${c.slug}`} data-cat={c.slug} aria-pressed="false" style={`--direction-color:${c.color}`}>
<span class="direction-top"><span class="direction-index">{String(i+1).padStart(2,"0")} / 08</span><span class="direction-count">{c.count} продуктов</span></span>
<img class="direction-symbol" src={`/ai-portfolio/marks/category-${c.slug}.svg`} width="112" height="112" alt="" loading="lazy" aria-hidden="true"/>
<span class="direction-bottom"><strong>{c.name}</strong><span class="direction-description">{c.short}</span></span>
<span class="direction-arrow" aria-hidden="true">↗</span>
</button>)}</div></section>
<section class="shell" id="catalog"><div class="section-row" style="padding-top:12px"><div><span class="eyebrow">02 / КАТАЛОГ</span><h2 class="section-heading">Каталог ИИ-продуктов</h2></div><span class="section-meta">68 продуктов · 8 направлений</span></div><div class="catalog-layout"><aside class="sidebar" id="sidebar" aria-label="Фильтры"><div class="side-group"><div class="side-heading">Для кого <span>01</span></div><label class="check-row"><input type="radio" name="author" value="all" checked> Все продукты</label><label class="check-row"><input type="radio" name="author" value="author"> Авторские разработки</label><label class="check-row"><input type="radio" name="author" value="student"> Ученические работы</label></div><div class="side-group"><div class="side-heading">Применимость к школе <span>02</span></div><label class="check-row"><input type="radio" name="school" value="all" checked> Все направления</label><label class="check-row"><input type="radio" name="school" value="direct"> Прямое школьное назначение</label><label class="check-row"><input type="radio" name="school" value="support"> Поддержка школьной работы</label></div><div class="side-note">Выбирайте продукт по задаче, направлению и области применения.</div></aside><div class="catalog-main"><div class="controls"><span class="result-count" id="count" aria-live="polite"></span><div class="control-right"><button class="filter-toggle" id="filter-toggle" type="button" aria-expanded="false" aria-controls="sidebar">☷ Фильтры</button><span class="sort-label">Сортировка:</span><select class="sort-select" id="sort" aria-label="Сортировать"><option value="editorial">По подборке</option><option value="name">По названию</option><option value="status">По стадии</option></select><button class="clear-btn" id="clear-filters" type="button">Сброс</button></div></div><div class="cards" id="cards" aria-live="polite"></div><div class="catalog-more" id="pager" hidden><span id="pager-status"></span><button type="button" id="load-more">Показать ещё ↓</button></div></div></div></section></main>
<footer class="footer shell" id="about"><span>AI LAB · ИИ-АГЕНТЫ И СИСТЕМЫ · V0.7.0</span><span>68 продуктов · 8 направлений</span></footer>
<script is:inline define:vars={{records:cardsForClient,aiEndpoint,turnstileKey}}>window.PORTFOLIO_RECORDS = records; window.PORTFOLIO_SCOPE = "all";window.AI_SEARCH_ENDPOINT=aiEndpoint;window.AI_TURNSTILE_SITE_KEY=turnstileKey;</script><script is:inline type="module" src="/ai-portfolio/assets/catalog.js"></script></body></html>

