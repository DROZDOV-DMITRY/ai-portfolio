---
import categories from "../../data/categories.json";
import { categoryRecords } from "../../lib/catalog.js";
export function getStaticPaths() {
  return categories.map(category => ({ params: { slug: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const items = categoryRecords(category.slug);
const canonical = `https://drozdov-dmitry.github.io/ai-portfolio/category/${category.slug}/`;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{category.name} — AI / Портфолио</title>
  <meta name="description" content={category.description} />
  <link rel="canonical" href={canonical} />
  <link rel="stylesheet" href="/ai-portfolio/assets/styles.css" />
<link rel="icon" type="image/svg+xml" href="/ai-portfolio/brand/mark.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/ai-portfolio/brand/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/ai-portfolio/brand/favicon-16.png" />
<link rel="shortcut icon" href="/ai-portfolio/brand/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/ai-portfolio/brand/apple-touch-icon.png" />
<meta name="theme-color" content="#101212" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI / Портфолио" />
<meta property="og:image" content="https://drozdov-dmitry.github.io/ai-portfolio/brand/og-cover.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" /></head>
<body>
 <div class="topline">V0.4 · ЧЕРНОВИК КАРТОЧЕК · НЕ ПУБЛИКОВАТЬ</div>
 <header class="header shell">
 <a class="brand" href="/ai-portfolio/"><img class="brand-emblem" src="/ai-portfolio/brand/mark.svg" alt="" width="39" height="39" aria-hidden="true" /><span class="brand-copy"><span class="brand-name">AI / ПОРТФОЛИО</span><span class="brand-sub">Авторские интеллектуальные системы</span></span></a>
 <nav class="navigation" aria-label="Основная навигация"><a href="/ai-portfolio/">Все решения</a><a class="nav-current" href="/ai-portfolio/#categories">Категории</a></nav>
 </header>
 <main class="shell" style="min-height:70vh">
 <section class="hero"><span class="eyebrow">КАТЕГОРИЯ / КОНТЕНТНАЯ СБОРКА</span><h1>{category.name}</h1><p class="hero-summary">{category.description}</p><a class="small-outline" href="/ai-portfolio/#categories">← Все категории</a></section>
 <section id="catalog"><div class="section-row"><div><span class="eyebrow">КАРТОЧКИ ДЛЯ РЕДАКЦИОННОЙ ПРОВЕРКИ</span><h2 class="section-heading">Разработки</h2></div><span class="section-meta">{items.length} описаний в работе</span></div>
 <div class="cards">
 {items.map(item => (<article class="product-card">
   <a class={`card-visual ${item.cover}`} href={item.detail} aria-label={`Подробнее: ${item.title}`}><span class="card-badge">{item.kind}</span><div class="card-graphic"><span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span><span class="big-letter">{item.num}</span><span class="visual-sub">AI LAB / КОНЦЕПТ</span></div></a>
   <div class="product-info"><div class="product-top"><span>{item.category}</span><span>{item.version}</span></div><h3 class="product-name"><a href={item.detail}>{item.title}</a></h3><p class="product-description">{item.subtitle}</p><div class="product-foot"><span class="foot-chip">{item.statusLabel}</span></div></div>
 </article>))}
 </div></section></main>
 <footer class="footer shell">Этап разработки · Описание не является публичной карточкой агента</footer>
</body>
</html>
